@startuml use_case
skinparam backgroundColor white
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam shadowing false
skinparam roundCorner 6

skinparam usecase {
  BackgroundColor white
  BorderColor #444444
  FontColor #222222
}

skinparam actor {
  BackgroundColor white
  BorderColor #444444
  FontColor #222222
}

skinparam rectangle {
  BackgroundColor #F7F7F7
  BorderColor #444444
  FontStyle bold
}

title <b>Use Case Diagram</b>\nExplainable Digital Twin for Data-Driven Irrigation Management in Tomato Cultivation

left to right direction

' -- Actors on Left --
actor "Farmer /\nDomain Expert" as FARMER
actor "ESP32 Sensor\nNode (planned)" as ESP32 #white;line.dashed

' -- System boundary in Middle --
rectangle "Explainable Digital Twin for Data-Driven Irrigation Management" as SYS {

  together {
    usecase "Get Comprehensive\nHealth Prediction" as UC_FULL
    usecase "Access Dashboard" as DASHBOARD
    usecase "Run What-If Simulation" as UC_WHATIF
    usecase "View Historical Trends" as UC_HISTORY
    usecase "Push Live Sensor\nData (planned)" as UC_PUSH #white;line.dashed
  }

  together {
    usecase "View Live Plant Status" as UC_VIEW
    usecase "Compare Plant Data" as UC_COMPARE
    usecase "Diagnose Plant Disease" as UC_DIAGNOSE
  }

  together {
    usecase "View AI Explanation" as UC_EXPLAIN
    usecase "View Treatment\nRecommendation" as UC_TREAT
  }

  ' -- Dashboard includes these three --
  DASHBOARD ..> UC_VIEW : <<include>>
  DASHBOARD ..> UC_COMPARE : <<include>>
  DASHBOARD ..> UC_DIAGNOSE : <<include>>

  ' -- Include/extend relationships --
  UC_FULL ..> UC_EXPLAIN : <<include>>
  UC_VIEW ..> UC_EXPLAIN : <<include>>
  UC_WHATIF ..> UC_VIEW : <<include>>
  UC_DIAGNOSE ..> UC_TREAT : <<extend>>\nif disease detected
}

' -- Farmer interactions --
FARMER --> UC_FULL
FARMER --> DASHBOARD
FARMER --> UC_WHATIF
FARMER --> UC_HISTORY

' -- Sensor interaction at bottom --
ESP32 .[#888888,dashed].> UC_PUSH

@enduml
