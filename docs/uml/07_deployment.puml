@startuml deployment_diagram
skinparam backgroundColor white
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam shadowing false
skinparam roundCorner 6
skinparam nodesep 25
skinparam ranksep 30

skinparam node {
  BackgroundColor white
  BorderColor #444444
  FontColor #222222
}

skinparam artifact {
  BackgroundColor white
  BorderColor #444444
}

skinparam database {
  BackgroundColor white
  BorderColor #444444
}

skinparam cloud {
  BackgroundColor white
  BorderColor #444444
}

skinparam note {
  BackgroundColor #FFFFEE
  BorderColor #AAAAAA
  FontSize 10
}

title <b>Diagram 7 -- Deployment Diagram</b>\nExplainable Digital Twin for Data-Driven Irrigation Management in Tomato Cultivation

' ═══════ ROW 1: USER BROWSER ═══════
node "<<client device>>\nUser Browser\n(Chrome / Edge)" as BROWSER {
  artifact "React SPA\n(HTML5 + JS + CSS)" as SPA
  artifact "Chart.js v4\n(Canvas rendering)" as CHARTJS
}

' ═══════ ROW 2: DEVELOPMENT MACHINE ═══════
node "<<execution environment>>\nDevelopment Machine\n(Windows 11, localhost)" as DEV {

  node "<<web server>>\nFrontend Server\nNode.js + Vite Dev Server\nlocalhost:5173" as VITE {
    artifact "App.jsx" as APP_JSX
    artifact "PlantCard.jsx" as PC_JSX
    artifact "WhatIfSimulator.jsx" as WIS_JSX
    artifact "ABComparison.jsx" as ABC_JSX
    artifact "api.js (Axios)" as API_JS
  }

  node "<<application server>>\nBackend Server\nWaitress WSGI (4 threads)\nlocalhost:5000" as FLASK_NODE {
    artifact "app.py\n(Flask REST controller)" as APP_PY

    node "<<runtime>>\nPython 3.13 Runtime" as ML_RT {
      artifact "XGBoost Classifier\nxgboost_irrigation.pkl" as XGB_ART
      artifact "Isolation Forest\n(bundled in pkl)" as ISO_ART
      artifact "SHAP TreeExplainer" as SHAP_ART
      artifact "EfficientNetB0\nefficientnet_finetuned.pth\n(PyTorch)" as ENET_ART
      artifact "Grad-CAM\ngradcam_inference.py" as GCAM_ART
      artifact "Late Fusion Engine\nmodels/fusion.py" as FUSE_ART
    }
  }

  database "<<file system>>\nLocal Filesystem\n(project root)" as FS {
    artifact "data/raw/*.csv\ndata/processed/*.csv" as CSV_ART
    artifact "PlantVillage Dataset\n(10 classes, ~18k images)" as PV_ART
    artifact "disease_treatment\n_lookup.json (ICAR)" as TREAT_ART
    artifact "models/*.pkl\nmodels/*.pth" as MODEL_FILES
  }
}

' ═══════ ROW 3: PLANNED FIELD + CLOUD ═══════
node "<<device>>\nField Installation (planned)" <<planned>> as FIELD #white;line.dashed {
  node "<<embedded>>\nESP32 Sensor Node\n(per-plant, Wi-Fi)" <<planned>> as ESP32_NODE #white;line.dashed {
    artifact "Soil Moisture\nSensor" as SOIL_SENSOR #white;line.dashed
    artifact "DHT22 Sensor\n(Temp + Humidity)" as DHT22 #white;line.dashed
  }
}

artifact "Camera Module\n(leaf capture, planned)" as CAMERA #white;line.dashed

cloud "<<cloud>>\nCloud Services (planned)" <<planned>> as CLOUD #white;line.dashed {
  database "Firebase RTDB\n(NoSQL, planned)" as FB #white;line.dashed
  node "OpenWeatherMap\nREST API (planned)" as OWM #white;line.dashed
}

' ═══════ CONNECTIONS ═══════
' Browser to Vite (user interaction)
BROWSER -down-> VITE : <<HTTP>>\nGET :5173

' Vite proxy to Flask (API calls)
VITE -down-> FLASK_NODE : <<HTTP proxy>>\n/api/* -> :5000\nJSON, multipart

' Backend reads filesystem
FLASK_NODE -right-> FS : <<filesystem>>\nreads artifacts

' Planned: ESP32 to Firebase
ESP32_NODE .[#888888,dashed].> FB : <<HTTPS>>\nWi-Fi push

' Planned: Firebase to Backend
FB .[#888888,dashed].> FLASK_NODE : <<HTTPS>>\npolling

' Planned: Weather API
OWM .[#888888,dashed].> FLASK_NODE : <<HTTPS>>\nforecast

' Planned: Camera upload
CAMERA .[#888888,dashed].> BROWSER : <<USB>>\nimage upload

' ═══════ FORCE LAYOUT ORDER ═══════
BROWSER -[hidden]d- DEV
DEV -[hidden]d- FIELD
FIELD -[hidden]r- CLOUD

@enduml
