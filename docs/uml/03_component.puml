@startuml component_diagram
skinparam backgroundColor white
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam shadowing false
skinparam roundCorner 6
skinparam packageStyle rectangle
skinparam nodesep 15
skinparam ranksep 25

skinparam component {
  BackgroundColor white
  BorderColor #444444
  FontColor #222222
}

skinparam package {
  BackgroundColor #F7F7F7
  BorderColor #444444
  FontStyle bold
}

skinparam database {
  BackgroundColor white
  BorderColor #444444
}

title <b>Component Diagram</b>\nExplainable Digital Twin for Data-Driven Irrigation Management in Tomato Cultivation

' ═══════ TOP ROW: Main components left to right ═══════

component [ESP32 Sensor Node\n(planned)] as ESP32 #white;line.dashed

package "Frontend (React + Vite + Chart.js)" as PKG_FE {
  component [App.jsx] as APP
  component [PlantCard.jsx] as PC
  component [ExplainabilityPanel.jsx\n+ ShapBars.jsx] as EP
  component [HistoryChart.jsx] as HC
  component [WhatIfSimulator.jsx] as WIS
  component [ABComparison.jsx] as ABC
  component [api.js] as APIJS

  APP --> PC
  APP --> WIS
  APP --> ABC
  PC --> EP
  PC --> HC
}

interface "REST API\n(8 endpoints)" as I_API

package "Backend (Flask + Waitress)" as PKG_BACK {
  component [app.py\nREST Controller] as APPPY
}

package "ML and Explainability" as PKG_ML {
  component [XGBoost\nIrrigation Classifier] as XGB
  component [Isolation Forest\nAnomaly Detector] as ISO
  component [EfficientNetB0\nDisease Classifier] as ENET
  component [SHAP TreeExplainer] as SHAP
  component [Grad-CAM] as GCAM
  component [LIME (offline only)] as LIME #white;line.dashed
  component [Late Fusion Engine\nmodels/fusion.py] as FUSION

  XGB --> FUSION
  ISO --> FUSION
  ENET --> FUSION
}

' ═══════ FORCE TOP ROW: side by side ═══════
PKG_FE -[hidden]r- I_API
I_API -[hidden]r- PKG_BACK
PKG_BACK -[hidden]r- PKG_ML

' ═══════ INTERFACE CONNECTIONS ═══════
APIJS ..> I_API : HTTP / JSON
APPPY -- I_API

' ═══════ BACKEND to ML ═══════
APPPY --> XGB
APPPY --> ISO
APPPY --> SHAP
APPPY --> ENET
APPPY --> GCAM
APPPY --> FUSION

' ═══════ BOTTOM ROW: Data stores ═══════
database [Sensor CSVs\ndata/raw/\ndata/processed/] as CSV
database [PlantVillage\nImage Dataset] as PV
database [disease_treatment\n_lookup.json] as TREAT
database [Model Artifacts\n.pkl  .pth] as MODELS
database [Firebase RTDB\n(planned)] as FB #white;line.dashed
component [OpenWeatherMap API\n(planned)] as OWM #white;line.dashed

' ═══════ DATA CONNECTIONS ═══════
CSV ..> APPPY
MODELS ..> XGB
MODELS ..> ENET
PV ..> ENET
TREAT ..> FUSION
OWM .[#888888,dashed].> FUSION
ESP32 .[#888888,dashed].> FB
FB .[#888888,dashed].> APPPY

@enduml
